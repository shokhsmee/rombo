# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production-use-64-random-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Production:
# DATABASE_URL=postgres://rombo:secret@localhost:5432/rombo
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=720

# Dev seed — first superuser created by `python manage.py seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345

# Telephony (optional): defaults for Telefoniya → Sozlamalar. The PBX's SIP-over-WebSocket address
# (Asterisk: wss://pbx.example.uz:8089/ws) and SIP domain. SIP passwords are set per user in the app.
TELEPHONY_SIP_WSS=
TELEPHONY_SIP_DOMAIN=
