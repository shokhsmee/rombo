# Copy to .env and adjust. Never commit the real .env.
ROMBO_ENV=dev
ROMBO_DATABASE_URL=sqlite:///./rombo.db
# Production example:
# ROMBO_DATABASE_URL=postgresql+psycopg://rombo:secret@localhost:5432/rombo
ROMBO_SECRET_KEY=change-me-in-production-use-64-random-chars
ROMBO_ACCESS_TOKEN_MINUTES=720
ROMBO_CORS_ORIGINS=["http://localhost:5173"]

# Seed (dev only) — first superuser created by `python -m app.cli seed`
ROMBO_SEED_ADMIN_USERNAME=admin
ROMBO_SEED_ADMIN_PASSWORD=admin12345
