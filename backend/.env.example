# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production-use-64-random-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Production:
# DATABASE_URL=postgres://rombo:secret@localhost:5432/rombo
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=720

# Dev seed — first superuser created by `python manage.py seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345

# Telephony (optional): defaults for Telefoniya → Sozlamalar. The PBX's SIP-over-WebSocket address
# (Asterisk: wss://pbx.example.uz:8089/ws) and SIP domain. SIP passwords are set per user in the app.
TELEPHONY_SIP_WSS=
TELEPHONY_SIP_DOMAIN=

# Encrypts secrets kept in the database (SIP passwords, amoCRM / Telegram / Google / AI keys).
# Required in production; generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: "new_key,old_key", re-save the settings, then drop old_key. Losing it = re-entering every secret.
FIELD_ENCRYPTION_KEY=

# Public address of this install (webhook URLs shown in Telefoniya / CRM ulanishlar, OAuth redirects)
PUBLIC_BASE_URL=
# Live updates across processes (crm_worker, telegram_listen): redis://localhost:6379/0. Empty = in-memory (dev)
REDIS_URL=
# Google Drive for call recordings: OAuth client (Web). Redirect URI:
#   <PUBLIC_BASE_URL>/api/v1/telephony/recordings/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram (my.telegram.org → API development tools); accounts may enter their own instead
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Outgoing email: purchase orders sent to suppliers (empty host = "Email sozlanmagan")
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
