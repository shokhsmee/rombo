[Unit]
Description=Rombo ERP Telegram listener (keeps connected accounts online)
After=network.target postgresql.service redis-server.service

[Service]
User=rombo-erp
Group=rombo-erp
WorkingDirectory=/opt/rombo-erp/backend
ExecStart=/opt/rombo-erp/backend/.venv/bin/python manage.py telegram_listen
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
